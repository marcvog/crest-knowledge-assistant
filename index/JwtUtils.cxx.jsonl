{"id": "12c35b2889ef3822e258a0922f18c2736bd98a385d703a19f0483c8c6efd1426", "kind": "method", "name": "extractExp", "qualified_name": "Crest::JwtUtils::extractExp", "namespace": "Crest", "source_file": "/workspaces/crest-knowledge-assistant/data/CrestApi/src/JwtUtils.cxx", "start_line": 54, "end_line": 75, "signature": "std::time_t JwtUtils::extractExp(const std::string& jwt, int graceSeconds) ", "documentation": null, "source_code": "std::time_t JwtUtils::extractExp(const std::string& jwt, int graceSeconds) {\n  size_t dot1 = jwt.find('.');\n  size_t dot2 = jwt.find('.', dot1 + 1);\n  if (dot1 == std::string::npos || dot2 == std::string::npos) {\n    throw std::runtime_error(\"Invalid JWT format\");\n  }\n\n  std::string payloadEncoded = jwt.substr(dot1 + 1, dot2 - dot1 - 1);\n  std::string payloadJson = base64urlDecode(payloadEncoded);\n\n  auto js = nlohmann::json::parse(payloadJson, nullptr, false);\n  if (js.is_discarded()) {\n    throw std::runtime_error(\"Failed to parse JWT payload\");\n  }\n\n  if (!js.contains(\"exp\") || !js[\"exp\"].is_number()) {\n    throw std::runtime_error(\"JWT payload does not contain valid 'exp'\");\n  }\n\n  std::time_t rawExp = js[\"exp\"];\n  return rawExp - graceSeconds;\n}"}
