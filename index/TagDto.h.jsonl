{"id": "7bfaaaa7f48c403c44725356f1b53190011684591a485b509dfce8157cd2c636", "kind": "enum", "name": "StatusEnum", "qualified_name": "Crest::StatusEnum", "namespace": "Crest", "source_file": "data/CrestApi/CrestApi/TagDto.h", "start_line": 37, "end_line": 37, "signature": "enum class StatusEnum ", "documentation": null, "source_code": "enum class StatusEnum { LOCKED, UNLOCKED }", "test_macro": null, "test_suite": null, "test_parameter_expression": null, "constant_value": null}
{"id": "ed37cee1871c62445efc6e48a343558e0931b15c23dd4b3fb28bd0cd1be22bed", "kind": "function", "name": "statusToString", "qualified_name": "Crest::statusToString", "namespace": "Crest", "source_file": "data/CrestApi/CrestApi/TagDto.h", "start_line": 39, "end_line": 49, "signature": "inline std::string statusToString(StatusEnum status) ", "documentation": null, "source_code": "inline std::string statusToString(StatusEnum status) {\n  int istatus = static_cast<int>(status);\n  switch (istatus) {\n    case static_cast<int>(StatusEnum::LOCKED):\n      return \"LOCKED\";\n    case static_cast<int>(StatusEnum::UNLOCKED):\n      return \"UNLOCKED\";\n    default:\n      throw std::invalid_argument(\"Invalid status\");\n  }\n}", "test_macro": null, "test_suite": null, "test_parameter_expression": null, "constant_value": null}
{"id": "d29b747db8c5ca323b53ec51261b5422dc083fd479417d5844f72ac2e009ceab", "kind": "function", "name": "toStatusEnum", "qualified_name": "Crest::toStatusEnum", "namespace": "Crest", "source_file": "data/CrestApi/CrestApi/TagDto.h", "start_line": 51, "end_line": 57, "signature": "inline StatusEnum toStatusEnum(const std::string &status) ", "documentation": null, "source_code": "inline StatusEnum toStatusEnum(const std::string &status) {\n  if (status == \"LOCKED\")\n    return StatusEnum::LOCKED;\n  if (status == \"UNLOCKED\")\n    return StatusEnum::UNLOCKED;\n  throw std::invalid_argument(\"Invalid status\");\n}", "test_macro": null, "test_suite": null, "test_parameter_expression": null, "constant_value": null}
{"id": "597b92d930b7616bf4ed26e691a9f6fff31dc49deab24a961d2c26614e9a9d40", "kind": "enum", "name": "SyncroEnum", "qualified_name": "Crest::SyncroEnum", "namespace": "Crest", "source_file": "data/CrestApi/CrestApi/TagDto.h", "start_line": 59, "end_line": 59, "signature": "enum class SyncroEnum ", "documentation": null, "source_code": "enum class SyncroEnum { ALL, SV, UPD }", "test_macro": null, "test_suite": null, "test_parameter_expression": null, "constant_value": null}
{"id": "de34e1e8dc9efc9ad63dee281d4c21cd5400e14b0eec98f60f83a51c091ba1b1", "kind": "function", "name": "synchroToString", "qualified_name": "Crest::synchroToString", "namespace": "Crest", "source_file": "data/CrestApi/CrestApi/TagDto.h", "start_line": 61, "end_line": 73, "signature": "inline std::string synchroToString(SyncroEnum synchro) ", "documentation": null, "source_code": "inline std::string synchroToString(SyncroEnum synchro) {\n  int isynchro = static_cast<int>(synchro);\n  switch (isynchro) {\n    case static_cast<int>(SyncroEnum::ALL):\n      return \"ALL\";\n    case static_cast<int>(SyncroEnum::SV):\n      return \"SV\";\n    case static_cast<int>(SyncroEnum::UPD):\n      return \"UPD\";\n    default:\n      throw std::invalid_argument(\"Invalid status\");\n  }\n}", "test_macro": null, "test_suite": null, "test_parameter_expression": null, "constant_value": null}
{"id": "972167a1e806188ab9e10ac84b19abe62911c241dac9de547429b5b07ea35c7d", "kind": "function", "name": "toSynchroEnum", "qualified_name": "Crest::toSynchroEnum", "namespace": "Crest", "source_file": "data/CrestApi/CrestApi/TagDto.h", "start_line": 75, "end_line": 83, "signature": "inline SyncroEnum toSynchroEnum(const std::string &synchro) ", "documentation": null, "source_code": "inline SyncroEnum toSynchroEnum(const std::string &synchro) {\n  if (synchro == \"ALL\")\n    return SyncroEnum::ALL;\n  if (synchro == \"SV\")\n    return SyncroEnum::SV;\n  if (synchro == \"UPD\")\n    return SyncroEnum::UPD;\n  throw std::invalid_argument(\"Invalid status\");\n}", "test_macro": null, "test_suite": null, "test_parameter_expression": null, "constant_value": null}
{"id": "e0e01eb1da410bf8626e07ddcf4677c48b0f01f51f5694f34708243f5c32fb20", "kind": "class", "name": "TagDto", "qualified_name": "Crest::TagDto", "namespace": "Crest", "source_file": "data/CrestApi/CrestApi/TagDto.h", "start_line": 85, "end_line": 149, "signature": "class TagDto ", "documentation": null, "source_code": "class TagDto {\n private:\n  std::string name;\n  std::string timeType;\n  std::string objectType;\n  std::string description;\n  std::string synchronization;\n  std::string status;\n  uint64_t lastValidatedTime;\n  uint64_t endOfValidity;\n  std::optional<std::string> insertionTime;\n  std::optional<std::string> modificationTime;\n\n public:\n  // Ctor\n  TagDto(const std::string &name, const std::string &timeType,\n         const std::string &description);\n  // Default Ctor\n  TagDto();\n  const std::string &getName() const { return name; }\n  const std::string &getTimeType() const { return timeType; }\n  const std::string &getObjectType() const { return objectType; }\n  const std::string &getDescription() const { return description; }\n  const std::string &getSynchronization() const { return synchronization; }\n  const std::string &getStatus() const { return status; }\n\n  uint64_t getLastValidatedTime() const { return lastValidatedTime; }\n  uint64_t getEndOfValidity() const { return endOfValidity; }\n  std::optional<std::string> getInsertionTime() const { return insertionTime; }\n  std::optional<std::string> getModificationTime() const {\n    return modificationTime;\n  }\n  // Define setters\n  void setName(const std::string &name) { this->name = name; }\n  void setTimeType(const std::string &timeType) { this->timeType = timeType; }\n  void setObjectType(const std::string &objectType) {\n    this->objectType = objectType;\n  }\n  void setDescription(const std::string &description) {\n    this->description = description;\n  }\n  void setSynchronization(const std::string &synchronization) {\n    SyncroEnum is = toSynchroEnum(synchronization);\n    this->synchronization = synchroToString(is);\n  }\n  void setStatus(const std::string &status) {\n    StatusEnum is = toStatusEnum(status);\n    this->status = statusToString(is);\n  }\n  void setLastValidatedTime(uint64_t lastValidatedTime) {\n    this->lastValidatedTime = lastValidatedTime;\n  }\n  void setEndOfValidity(uint64_t endOfValidity) {\n    this->endOfValidity = endOfValidity;\n  }\n  void setInsertionTime(const std::string &insertionTime) {\n    this->insertionTime = insertionTime;\n  }\n  void setModificationTime(const std::string &modificationTime) {\n    this->modificationTime = modificationTime;\n  }\n\n  json toJson() const;\n  static TagDto fromJson(const json &j);\n}", "test_macro": null, "test_suite": null, "test_parameter_expression": null, "constant_value": null}
