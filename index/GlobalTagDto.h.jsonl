{"id": "4ac17ddd13910b4a591651181c9057ce46e59672a89292823691a2e2031944db", "kind": "enum", "name": "TypeEnum", "qualified_name": "TypeEnum", "namespace": null, "source_file": "data/CrestApi/CrestApi/GlobalTagDto.h", "start_line": 16, "end_line": 16, "signature": "enum class TypeEnum ", "documentation": null, "source_code": "enum class TypeEnum { TEST, LOCKED, NONE }", "test_macro": null, "test_suite": null, "test_parameter_expression": null, "constant_value": null}
{"id": "049c136aacadc71500fea90c0c3b1ec90ebd048917069b8e5eb2766335fbef03", "kind": "function", "name": "typeToString", "qualified_name": "typeToString", "namespace": null, "source_file": "data/CrestApi/CrestApi/GlobalTagDto.h", "start_line": 18, "end_line": 30, "signature": "inline std::string typeToString(TypeEnum ts) ", "documentation": null, "source_code": "inline std::string typeToString(TypeEnum ts) {\n  int is = static_cast<int>(ts);\n  switch (is) {\n    case static_cast<int>(TypeEnum::LOCKED):\n      return \"L\";\n    case static_cast<int>(TypeEnum::TEST):\n      return \"T\";\n    case static_cast<int>(TypeEnum::NONE):\n      return \"N\";\n    default:\n      throw std::invalid_argument(\"Invalid type\");\n  }\n}", "test_macro": null, "test_suite": null, "test_parameter_expression": null, "constant_value": null}
{"id": "8158c162fc7742032f65f302df0d5e39be03f019acbd29260afcd28c46ced6df", "kind": "function", "name": "toTypeEnum", "qualified_name": "toTypeEnum", "namespace": null, "source_file": "data/CrestApi/CrestApi/GlobalTagDto.h", "start_line": 32, "end_line": 40, "signature": "inline TypeEnum toTypeEnum(const std::string &ts) ", "documentation": null, "source_code": "inline TypeEnum toTypeEnum(const std::string &ts) {\n  if (ts == \"L\")\n    return TypeEnum::LOCKED;\n  if (ts == \"T\")\n    return TypeEnum::TEST;\n  if (ts == \"N\")\n    return TypeEnum::NONE;\n  throw std::invalid_argument(\"Invalid type\");\n}", "test_macro": null, "test_suite": null, "test_parameter_expression": null, "constant_value": null}
{"id": "4ce9c81c97f5770cb6b2f8bbac0e494ba74a27b79e8b0466aff232cfad58be57", "kind": "class", "name": "GlobalTagDto", "qualified_name": "Crest::GlobalTagDto", "namespace": "Crest", "source_file": "data/CrestApi/CrestApi/GlobalTagDto.h", "start_line": 44, "end_line": 98, "signature": "class GlobalTagDto ", "documentation": null, "source_code": "class GlobalTagDto {\n private:\n  std::string name;\n  int64_t validity;\n  std::string description;\n  std::string release;\n  std::optional<std::string> insertionTime;\n  std::optional<std::string> snapshotTime;\n  std::string scenario;\n  std::string workflow;\n  std::string type;\n  int64_t snapshotTimeMilli;\n  int64_t insertionTimeMilli;\n\n public:\n  // Ctor\n  GlobalTagDto(const std::string &name, const std::string &description,\n               const std::string &release, const std::string &workflow);\n\n  // Default Ctor\n  GlobalTagDto();\n\n  // Setters and Getters\n  const std::string &getName() const { return name; }\n  int64_t getValidity() const { return validity; }\n  const std::string &getDescription() const { return description; }\n  const std::string &getRelease() const { return release; }\n  std::optional<std::string> getInsertionTime() const { return insertionTime; }\n  std::optional<std::string> getSnapshotTime() const { return snapshotTime; }\n  const std::string &getScenario() const { return scenario; }\n  const std::string &getWorkflow() const { return workflow; }\n  const std::string &getType() const { return type; }\n  int64_t getSnapshotTimeMilli() const { return snapshotTimeMilli; }\n  int64_t getInsertionTimeMilli() const { return insertionTimeMilli; }\n\n  void setName(const std::string &name) { this->name = name; }\n  void setRelease(const std::string &release) { this->release = release; }\n  void setWorkflow(const std::string &workflow) { this->workflow = workflow; }\n  void setValidity(int64_t validity) { this->validity = validity; }\n  void setDescription(const std::string &description) {\n    this->description = description;\n  }\n  void setSnapshotTime(const std::string &snapshotTime) {\n    this->snapshotTime = snapshotTime;\n  }\n  void setScenario(const std::string &scenario) { this->scenario = scenario; }\n  void setType(const std::string &type) {\n    TypeEnum is = toTypeEnum(type);\n    this->type = typeToString(is);\n  }\n\n  json toJson() const;\n\n  static GlobalTagDto fromJson(const json &j);\n}", "test_macro": null, "test_suite": null, "test_parameter_expression": null, "constant_value": null}
